[Unit]
Description=Gunicorn for RydeSaathi
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/rydesaathi/server
ExecStart=/home/ubuntu/rydesaathi/server/venv/bin/gunicorn config.wsgi:application --bind 0.0.0.0:8000 --workers 3
Restart=always

[Install]
WantedBy=multi-user.target
